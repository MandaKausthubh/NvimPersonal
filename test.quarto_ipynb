      "source": [
        "import keras as kr\n",
        "\n",
        "# Create a Population Based Training object \n",
        "pbt = kr.optimizers.PopulationBasedTraining(\n",
        "  hyperparameters = {\n",
        "    'learning_rate': 0.1,\n",
        "    'decay': 1e-6\n",
        "  }\n",
        ")"
